# Copy to .env and fill in. NEVER commit .env.

APP_ENV=production            # development | production
SECRET_KEY=                   # python -c "import secrets; print(secrets.token_hex(32))"

# Login for the web UI (hash, not plaintext): python tools/make_hash.py
ACCESS_PASSWORD_HASH=
# Bearer token for scripts/API clients: Authorization: Bearer <token>
API_TOKEN=

# Empty = enable every service found in app/services. Or e.g. diagnostics,wikipedia
ENABLED_SERVICES=

# Behind PythonAnywhere's proxy keep 1 (so client IPs are read correctly)
TRUST_PROXY=1

# Provider keys (used by services added in later steps)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
