# Copy to .env and fill in. NEVER commit .env.

APP_ENV=production            # development | production
SECRET_KEY=                   # python -c "import secrets; print(secrets.token_hex(32))"

# Bearer token for scripts/API clients: Authorization: Bearer <token>
API_TOKEN=

# Persistent database location (default: instance/wartime_mirror.sqlite3)
# For PythonAnywhere, use an absolute path outside the deploy directory, e.g.
# DATABASE_URL=sqlite:////home/yourusername/.local/share/wartime-mirror.sqlite3
DATABASE_URL=

# Empty = enable all services; Wikipedia, DuckDuckGo, and Google Search require their feature flags too
ENABLED_SERVICES=

# Wikipedia feature flag; if ENABLED_SERVICES is set, include wikipedia there too
WIKIPEDIA_ENABLED=0

# DuckDuckGo web search; unofficial ddgs integration, no API key required
DUCKDUCKGO_ENABLED=0

# Google Search via SerpApi's Google engine; disabled unless explicitly enabled
GOOGLE_SEARCH_ENABLED=0
SERPAPI_API_KEY=

# Behind PythonAnywhere's proxy keep 1 (so client IPs are read correctly)
TRUST_PROXY=1

# Optional AI provider keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# AI gateway request timeout and maximum upstream response size
AI_TIMEOUT=60
AI_MAX_RESPONSE_BYTES=5000000
# Maximum stream lifetime and maximum idle time between provider bytes (seconds)
AI_STREAM_TIMEOUT=240
AI_STREAM_IDLE_TIMEOUT=30
